# Project URL only — not the /rest/v1 endpoint
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# Production URL for invite links & QR codes (optional; defaults to browser origin)
VITE_PUBLIC_APP_URL=https://your-app.example.com

# Public OneSignal App ID (Settings → Keys & IDs). Safe to ship in the app.
# Do not put the OneSignal REST API key here — set ONESIGNAL_REST_KEY as a Supabase secret.
ONESIGNAL_APP_ID=
